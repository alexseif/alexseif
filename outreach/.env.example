# Outreach Engine Configuration

# Sending Provider: 'smtp' or 'brevo'
OUTREACH_PROVIDER=smtp

# SMTP Credentials (if using smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_app_password
SMTP_USE_TLS=true

# Brevo API (if using brevo)
BREVO_API_KEY=

# Sender Details
SENDER_NAME=Alex Seif
SENDER_EMAIL=alex.seif@gmail.com
REPLY_TO_EMAIL=alex.seif@gmail.com

# Enrichment APIs (Optional)
HUNTER_API_KEY=

# Rate Limiting & Safety
MIN_DELAY_SECONDS=60
MAX_DELAY_SECONDS=90
DAILY_SEND_LIMIT=30
